NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tribely?schema=public

JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# How long an emailed verification code stays valid before the user must
# request a new one via POST /auth/resend-verification. Format: <n><s|m|h|d>.
EMAIL_VERIFICATION_TTL=48h
# How long an emailed password-reset code stays valid before the user must
# request a new one via POST /auth/forgot-password. Format: <n><s|m|h|d>.
PASSWORD_RESET_TTL=24h

# Email transport — "log" (dev default, prints to logger) or "resend" (real send)
# Boot refuses EMAIL_TRANSPORT=log when NODE_ENV=production — the log
# transport writes verification codes to stdout, which is a credential leak
# in any environment with log aggregation. Use EMAIL_TRANSPORT=resend in prod.
EMAIL_TRANSPORT=log
# Required when EMAIL_TRANSPORT=resend. Get from https://resend.com/api-keys
RESEND_API_KEY=
# `onboarding@resend.dev` works without DNS verification but only delivers
# to the email registered with your Resend account — perfect for local dev
# and the eyeball integration tests. For production / staging, verify your
# sender domain at https://resend.com/domains and switch to e.g.
# `Tribely <noreply@gotribely.com>`.
EMAIL_FROM=onboarding@resend.dev
# Base URL of the API. Reserved for future deep-link / share flows; current
# verification + reset emails carry codes (not URLs) since Tribely is
# mobile-only and has no web UI.
APP_BASE_URL=http://localhost:3000

# Optional: set to your real inbox to opt into the "eyeball" integration
# tests that actually deliver email. With EMAIL_FROM=onboarding@resend.dev,
# Resend only delivers to the email registered with your Resend account.
# EMAIL_TEST_RECIPIENT=you@example.com

# Active verification signal set. See docs/specs/user-is-verified-projection.md.
# Production default keeps all three; the projection returns false for every
# user until TRI-16 (phone) and TRI-23 (selfie) ship their populate-the-column
# behavior. CEO-preauthorized fallback: VERIFIED_SIGNAL_SET=email,selfie.
VERIFIED_SIGNAL_SET=email,phone,selfie

# SMS_TRANSPORT: "log" (dev default — accepts magic code "000000" for any
# phone, prints attempts to logger) or "twilio" (real Twilio Verify).
# Boot refuses SMS_TRANSPORT=log when NODE_ENV=production — the magic code
# is a credential-bypass and is dev-only.
# Must be explicit — presence of Twilio vars alone does NOT activate Twilio;
# set SMS_TRANSPORT=twilio to switch over.
SMS_TRANSPORT=log
# Required when SMS_TRANSPORT=twilio. Account SID from https://console.twilio.com
# (starts with "AC").
TWILIO_ACCOUNT_SID=
# Required when SMS_TRANSPORT=twilio. Auth Token from https://console.twilio.com
# (keep secret — treat like a password).
TWILIO_AUTH_TOKEN=
# Required when SMS_TRANSPORT=twilio. Verify Service SID from
# https://console.twilio.com/us1/develop/verify/services (starts with "VA").
TWILIO_VERIFY_SERVICE_SID=
# Comma-separated list of E.164 country code prefixes to allow. Phone numbers
# whose prefix does not match any entry are rejected BEFORE the Twilio call
# (returns { status: 'invalid' } to the caller; no Twilio quota consumed).
# Default '+65' = Singapore-only for v1 launch. Add markets without a code
# change: SMS_ALLOWED_COUNTRY_CODES=+65,+60,+62
SMS_ALLOWED_COUNTRY_CODES=+65

# Object storage — "log" (dev default, prints to logger) or "s3" (real AWS S3).
# Boot refuses STORAGE_TRANSPORT=log when NODE_ENV=production.
# S3 adapter pending TRI-5 — STORAGE_TRANSPORT=s3 will throw at boot until that lands.
STORAGE_TRANSPORT=log
# Required when STORAGE_TRANSPORT=s3. The S3 bucket name for uploaded objects.
STORAGE_BUCKET=
# Required when STORAGE_TRANSPORT=s3. AWS region where the bucket is hosted (e.g. ap-southeast-1).
STORAGE_REGION=
# Required when STORAGE_TRANSPORT=s3. AWS IAM access key with PutObject/DeleteObject/GetObject perms.
AWS_ACCESS_KEY_ID=
# Required when STORAGE_TRANSPORT=s3. AWS IAM secret key (keep secret — treat like a password).
AWS_SECRET_ACCESS_KEY=
