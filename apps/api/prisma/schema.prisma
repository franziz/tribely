// Prisma 7+: the datasource block no longer accepts `url`. Connection URLs
// for `prisma migrate` / `prisma studio` live in `prisma.config.ts`; the
// runtime PrismaClient connects via a driver adapter (see core/db/prisma.ts).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Aggregate root in the `users` bounded context.
/// Owns identity-as-known-to-the-business: who someone is to others on the platform.
///
/// Profile fields added in TRI-7 (all optional):
///   - bio          free-text self-description, max 300 chars
///   - avatarUrl    nullable URL; no upload pipeline (CEO constraint, TRI-7)
///   - languages    array of BCP-47-aligned codes from the platform picklist
///   - interests    array of activity codes from the platform picklist
///   - currentCity  free-text city name, max 80 chars (no geo-restriction)
///   - travelerType TEXT column, CHECK constraint enforces 'local'|'traveling'|'expat'
///                  per TRI-41 convention (string column + DB CHECK, not Prisma enum)
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  displayName     String
  emailVerifiedAt DateTime?
  bio             String?
  avatarUrl       String?
  languages       String[] @default([])
  interests       String[] @default([])
  currentCity     String?
  travelerType    String?
  phone           String?
  phoneVerifiedAt DateTime?
  // Partial unique on `phone WHERE phoneVerifiedAt IS NOT NULL` — see migration 20260518131307_add_user_phone/migration.sql
  // Selfie verification (TRI-70). selfieStatus / selfieLastFailureCategory are TEXT + CHECK constraint
  // (not Postgres enum) per codebase convention. selfieAttemptCount is NOT NULL DEFAULT 0.
  // selfieAppealLockedAt is set when attemptCount >= 3 after a rejection; cleared by appeal approval.
  selfieStatus              String?   // pending | approved | rejected — CHECK enforced by migration
  selfieAttemptCount        Int       @default(0)
  selfieLastFailureCategory String?   // SelfieFailureCategory — CHECK enforced by migration
  selfieAppealLockedAt      DateTime?
  /// TRI-132 admin role: set to true out-of-band via SQL by an operator.
  /// The aggregate has no grantAdmin/revokeAdmin method — admin-ness is not a
  /// business invariant the app enforces; it is a DB-level operational grant.
  isAdmin                   Boolean   @default(false)
  /// TRI-134 tombstone: set to non-null by User.tombstone(now). A tombstoned user has had all
  /// PII columns cleared and email replaced with a placeholder. The row is retained (not hard-
  /// deleted) so FK constraints on events/join_requests are intentionally absent post-TRI-134
  /// (see migration tri134_drop_event_host_and_jr_requester_fks) — events and join-requests
  /// remain queryable post-tombstone with an opaque cuid2 pseudonym in hostUserId /
  /// requesterUserId. Downstream cascade mutations (credential revoke, token purge, etc.) are
  /// driven by the DeleteAccountUseCase.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  credential               Credential?
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  selfies                  Selfie[]
  // postEventCheckIns and hostedCheckIns back-relations removed: both FKs dropped for TRI-134
  // pseudonymisation — see migration drop_post_event_check_ins_user_fk.
  reviewsAsRater           Review[]      @relation("ReviewsAsRater")
  reviewsAsRated           Review[]      @relation("ReviewsAsRated")
  reportsAsReporter        Report[]      @relation("ReportsAsReporter")

  @@map("users")
}

/// Aggregate root in the `auth` bounded context.
/// Owns the secret material used to authenticate a user. Lives separately from User
/// so credential rotation, password changes, and future auth methods (OAuth, passkeys)
/// don't touch the User aggregate.
model Credential {
  userId         String   @id
  passwordHash   String
  passwordSetAt  DateTime @default(now())
  lastSignedInAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// Long-lived authentication credential. Each row is a single "session" — one device
/// or one logical client. Lives in the `auth` bounded context. The token itself is
/// hashed (SHA-256 over a 32-byte random secret); plaintext is shown to the client
/// once at issue time and never persisted.
///
/// Rotation: when /auth/refresh is called, the current token is marked revoked
/// (revokedReason='rotated') and a new RefreshToken is issued, with `rotatedToId`
/// pointing to the new row — preserving the chain for reuse-detection forensics.
///
/// Reuse-detection: if a token whose revokedAt is set (already-rotated) is presented
/// again, treat it as theft and revoke ALL of the user's tokens.
model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String? // 'rotated' | 'signed_out' | 'reuse_detected' | 'sign_out_all' | 'password_reset'
  lastUsedAt    DateTime?
  rotatedToId   String? // chain pointer to the next token after rotation
  deviceLabel   String? // optional, derived from User-Agent

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// One-time email verification code. Lives in the `auth` bounded context.
/// The 6-digit code shown to the user is hashed (SHA-256) at rest. Only one
/// open token per user at a time — issuing a new one revokes any prior open
/// row (single open invariant). `attempts` counts wrong-code submissions; use
/// cases invalidate the row once attempts hits the cap to defeat brute-force.
model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  codeHash    String
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  invalidated Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// One-time password-reset code. Lives in the `auth` bounded context.
/// Same shape as EmailVerificationToken (both compose the OneTimeCodeLifecycle
/// VO at the domain layer), but a separate table — different lifecycle, different
/// retention, different audit trail. The 6-digit code shown to the user is hashed
/// (SHA-256) at rest. Only one open token per user at a time — issuing a new one
/// invalidates any prior open row (single open invariant). `attempts` counts
/// wrong-code submissions; the row self-invalidates once attempts hits the cap to
/// defeat brute-force.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  codeHash    String
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  invalidated Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Aggregate root in the `events` bounded context. The core "thing happening"
/// a host creates and others request to join. Lifecycle: draft → published →
/// (cancelled | completed); transitions are enforced by the domain layer.
///
/// Venue is denormalized onto the row (no separate venues table) — Singapore-
/// only MVP doesn't justify a venue registry yet. `venueLatitude` /
/// `venueLongitude` are NUMERIC(9,6) (≈ 11 cm precision globally). PostGIS is
/// a deliberate non-goal for MVP; distance queries (TRI-19) can use
/// `earth_distance` or app-side calculation, with a PostGIS migration in a
/// later issue once geospatial query volume justifies it.
///
/// `category` / `costSplit` / `approvalMode` / `status` are plain String
/// columns rather than Prisma enums — matches the codebase convention
/// (cf. `revokedReason` on RefreshToken) and avoids Prisma enum migration
/// friction when values evolve. Type guards in the mapper narrow strings
/// back to unions when rehydrating.
///
/// TRI-134 cascade tombstones the User row; `onDelete: Cascade` remains as
/// defence-in-depth for any future hard-delete path but is NOT exercised by
/// the account-deletion cascade.
model Event {
  id                 String   @id @default(cuid())
  hostUserId         String
  title              String
  description        String?
  venueAddress       String
  venueCity          String
  venueLatitude      Decimal  @db.Decimal(9, 6)
  venueLongitude     Decimal  @db.Decimal(9, 6)
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int
  category           String // drinks | food | hike | museum | sports | nightlife | other
  venueCategory      String @default("other") // hawker_centre | park | museum | ... | other (CHECK enforced by migration)
  costSplit          String // own | host_paid | split
  approvalMode       String // auto | manual
  status             String // draft | published | cancelled | completed
  cancellationReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // host FK deliberately absent: TRI-134 pseudonymisation rewrites hostUserId to a cuid2
  // with no User row; removing the FK lets events remain queryable post-tombstone.
  // See migration tri134_drop_event_host_and_jr_requester_fks.
  joinRequests      JoinRequest[]
  postEventCheckIns PostEventCheckIn[]
  reviews           Review[]

  @@index([hostUserId])
  @@index([status, startsAt])
  @@index([category, startsAt])
  @@index([venueCity, startsAt])
  @@map("events")
}

/// Aggregate root in the `join-requests` bounded context. Tracks a single
/// user's request to join an event. Lifecycle: pending → (approved|rejected|cancelled).
/// Strict idempotency: same-state transitions throw 409 with a structured subcode
/// in details, NOT silent no-ops — protects the audit chain (see TRI-20).
///
/// Capacity correctness: approval reads parent Event row FOR UPDATE inside the
/// transaction, counts approved siblings, compares against (capacity - 1) since
/// capacity includes the host.
///
/// One ACTIVE request per (event, requester) is enforced by a partial unique
/// index added in the migration directly (Prisma DSL doesn't model partial
/// unique constraints as of v7). After reject/cancel the row stays for audit
/// but no longer matches the partial predicate — user can request again.
model JoinRequest {
  id              String    @id @default(cuid())
  eventId         String
  requesterUserId String
  status          String // pending | approved | rejected | cancelled | removed_by_host
  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  decisionReason  String?

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // requester FK deliberately absent: TRI-134 pseudonymisation rewrites requesterUserId to a
  // cuid2 with no User row; removing the FK lets join-requests remain visible to the host
  // post-tombstone. See migration tri134_drop_event_host_and_jr_requester_fks.

  @@index([eventId, status])
  @@index([requesterUserId, status])
  @@map("join_requests")
}

/// Aggregate root in the `reviews` bounded context.
/// Tracks a single user's post-event review of another participant in the same
/// completed event. Lifecycle: submitted → (edited | hidden).
///
/// Unique constraint on (eventId, raterUserId, ratedUserId) — one review per
/// pair per event. Both host-rates-guest and guest-rates-host are allowed.
///
/// `hidden` is set by moderators after a report. Hidden reviews are excluded
/// from the rated user's profile and aggregate rating, but retained for 180
/// days per the PDPA retention policy (docs/policies/pdpa-retention-tri30.md).
///
/// `rating` is validated at the domain layer (1..5) and additionally by a
/// CHECK constraint in the migration.
model Review {
  id           String    @id @default(cuid())
  eventId      String
  raterUserId  String
  ratedUserId  String
  rating       Int
  comment      String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hidden       Boolean   @default(false)
  hiddenAt     DateTime?
  hiddenReason String?

  rater User  @relation("ReviewsAsRater", fields: [raterUserId], references: [id], onDelete: Cascade)
  rated User  @relation("ReviewsAsRated", fields: [ratedUserId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, raterUserId, ratedUserId])
  @@index([ratedUserId, hidden, createdAt(sort: Desc)])
  @@index([raterUserId, createdAt(sort: Desc)])
  @@index([eventId])
  @@index([hidden, hiddenAt])
  @@map("reviews")
}

/// Aggregate root in the `reports` bounded context.
/// Tracks a user-filed content-moderation report targeting another entity
/// (initially only 'review', with 'user' and 'event' as stubs).
///
/// `targetType` / `reason` / `resolution` are plain String columns with
/// DB CHECK constraints enforcing the closed enums — consistent with the
/// codebase convention (cf. Event.status, JoinRequest.status).
///
/// Append-only invariant: once `resolvedAt` is set it cannot change. This is
/// enforced at the application layer (ReportAlreadyResolved domain error) because
/// a DB-level enforcement would require a trigger; the domain layer is the SOT.
///
/// `reporterUserId` has an FK to User with onDelete: Cascade — when a user is
/// hard-deleted their filed reports are also deleted (PDPA minimum-retention
/// for personal data the user themselves generated).
model Report {
  id                   String    @id @default(cuid())
  reporterUserId       String
  targetType           String    // review | user | event — CHECK enforced by migration
  targetId             String
  reason               String    // harassment | hate_speech | ... — CHECK enforced by migration
  comment              String?   @db.VarChar(500)
  createdAt            DateTime  @default(now())
  firstReviewedAt      DateTime?
  resolvedAt           DateTime?
  resolution           String?   // hidden | kept — CHECK enforced by migration
  resolvedByUserId     String?
  escalatedAt          DateTime? // null = not escalated; non-null = escalated
  escalationCategory   String?   // criminal-content | imminent-harm | ambiguous-policy | external-jurisdiction — CHECK enforced; paired-null with escalatedAt
  externalRef          String?   @db.VarChar(500) // operator-supplied external reference; paired-null with escalatedAt
  escalatedByUserId    String?   // operator user ID who escalated; paired-null with escalatedAt

  reporter User @relation("ReportsAsReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
  @@index([targetType, targetId])
  @@index([reporterUserId])
  @@index([escalatedAt])
  @@map("reports")
}

/// Aggregate root in the `user-blocks` bounded context.
/// Tracks a directional block relationship: `initiatorUserId` chose to block
/// `blockedUserId`. Block visibility checks are BIDIRECTIONAL — if A blocks B,
/// neither can see the other's content.
///
/// A DB-level CHECK constraint enforces no self-blocks as defense in depth
/// (the domain layer's `UserBlock.initiate` also rejects self-blocks).
///
/// `@@unique([initiatorUserId, blockedUserId])` ensures only one active block
/// per (initiator, blocked) pair. The reverse direction has its own row if B
/// subsequently blocks A.
model UserBlock {
  id              String    @id @default(cuid())
  initiatorUserId String
  blockedUserId   String
  createdAt       DateTime  @default(now())

  @@unique([initiatorUserId, blockedUserId])
  @@index([initiatorUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

/// Transactional outbox: domain events written in the same Postgres transaction
/// as the data change that produced them. Append-only — the dispatcher tracks
/// progress per consumer in `consumer_offsets`, not on the event row.
///
/// `seq` is the monotonic offset consumers commit against. `requestId` /
/// `actorUserId` carry HTTP correlation forward into the dispatch tick (the
/// dispatcher re-establishes the AsyncLocalStorage frame from these fields).
model OutboxEvent {
  id            String   @id @default(cuid())
  seq           BigInt   @unique @default(autoincrement())
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime @default(now())
  requestId     String?
  actorUserId   String?

  @@index([seq])
  @@index([type, seq])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Per-consumer offset cursor. Each registered Consumer has one row identified
/// by `consumerName` (e.g. `auth.issueEmailVerificationOnUserRegistered`).
///
/// Maps to Kafka's `__consumer_offsets` topic: `committedSeq` is what the
/// consumer has finished processing; `inFlightSeq` is the row currently being
/// retried (head-of-line block — dispatcher will not advance past a failure
/// until that specific event succeeds or hits `maxAttempts` and is parked).
///
/// `blockedAt` is set when attempts exceeds the consumer's max — manual
/// intervention required (clear `blockedAt` + reset `attempts` to resume).
model ConsumerOffset {
  consumerName String    @id
  topic        String
  committedSeq BigInt    @default(0)
  inFlightSeq  BigInt?
  attempts     Int       @default(0)
  lastError    String?
  lastErrorAt  DateTime?
  blockedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([topic])
  @@index([blockedAt])
  @@map("consumer_offsets")
}

/// Audit row per inbound HTTP request. Bounded context: `audit` feature.
/// Body content is intentionally NOT stored (PDPA-friendly); only headers,
/// status, duration, actor identity. Domain payloads from the request live in
/// `outbox_events` already.
model HttpAuditLog {
  id          String   @id @default(cuid())
  requestId   String   @unique
  method      String
  path        String
  status      Int
  durationMs  Int
  actorUserId String?
  ip          String?
  userAgent   String?
  errorCode   String?
  receivedAt  DateTime @default(now())

  @@index([actorUserId, receivedAt])
  @@index([receivedAt])
  @@map("http_audit_logs")
}

/// Audit row per event lifecycle phase. `phase` distinguishes:
///   - `published`  (consumerName=null) — event was written to the outbox
///   - `dispatched` — consumer handled successfully
///   - `failed`     — consumer threw; will retry next tick
///   - `blocked`    — consumer hit maxAttempts; parked for manual review
model EventAuditLog {
  id           String   @id @default(cuid())
  requestId    String?
  eventSeq     BigInt
  eventType    String
  consumerName String?
  phase        String
  attempt      Int?
  errorMessage String?
  recordedAt   DateTime @default(now())

  @@index([requestId])
  @@index([eventSeq, consumerName])
  @@index([consumerName, phase, recordedAt])
  @@map("event_audit_logs")
}

/// Audit row per selfie deletion. Bounded context: `audit` feature.
/// Append-only. NO application-layer UPDATE path — see repository surface.
///
/// PDPA s25 driver: deletion-of-personal-data evidence must survive the
/// user record itself. `userId` is a plain String (NOT a relation/FK) so
/// these rows persist beyond user-record deletion. Do NOT add a relation
/// to User here, ever — it would defeat the regulatory purpose.
///
/// 24-month retention: rows pruned by the audit feature's scheduled job
/// where `deletedAt < now() - 24 months`. Distinct from the 30-day
/// selfie-image retention sweep (TRI-79).
model SelfieDeletionEvent {
  id        String   @id @default(cuid())
  userId    String   // plain string, deliberately NOT a relation — see model comment
  selfieId  String
  reason    String   // closed enum at launch: retention-sweep | account-deletion | user-request | reviewer-rejection-aged
  deletedAt DateTime
  requestId String?  // joinable to http_audit_logs.requestId; nullable for non-HTTP origins (retention-sweep)
  recordedAt DateTime @default(now())

  @@index([userId, deletedAt])
  @@index([deletedAt])
  @@index([requestId])
  @@map("selfie_deletion_events")
}

/// Append-only audit log for account deletion events. Bounded context: `audit` feature.
///
/// PDPA s24 driver: evidence of data deletion must survive the user record itself.
/// `userIdHash` is a SHA-256 hex hash (64 chars) — non-reversible pseudonymisation.
/// Deliberately NOT a relation to User — rows must outlive user-record tombstoning
/// for PDPA s24 evidence integrity. Do NOT add a relation to User here, ever.
///
/// `cascadeScope` records which classes of data were touched as a TEXT[] (not JSONB)
/// for simple query and operator readability.
///
/// `outcome` is a plain String column; a CHECK constraint in the migration enforces
/// the closed enum: outcome IN ('completed', 'failed_rolled_back').
///
/// No application-layer UPDATE or prune path — append-only by contract (legal Q3).
/// Read access is out-of-band SQL only — no public-port read methods.
model AccountDeletionEvent {
  id            String   @id @default(cuid())
  userIdHash    String   // SHA-256 hex of userId — non-reversible; plain String, NOT a relation
  requestedAt   DateTime
  completedAt   DateTime
  requestId     String?  // joinable to http_audit_logs.requestId; nullable for non-HTTP origins
  cascadeScope  String[] @default([]) // AccountDeletionCascadeScope values — TEXT[], not JSONB
  outcome       String   // completed | failed_rolled_back — CHECK enforced by migration
  failureReason String?
  recordedAt    DateTime @default(now())

  @@index([userIdHash, recordedAt])
  @@index([recordedAt])
  @@index([requestId])
  @@map("account_deletion_events")
}

/// Append-only audit log for moderation actions taken via the operator CLI
/// (apps/api/scripts/moderation.ts). Bounded context: `audit` feature.
///
/// PDPA s24 evidence integrity driver: audit row commits ATOMICALLY with the
/// triggering report state transition (and any cascaded review hide). Caller
/// MUST pass TxContext to the repository — see SelfieDeletionEvent precedent.
///
/// `operatorUserId` is captured by the CLI from --operator flag or env var;
/// plain String, NOT a relation — audit row must outlive any user-record
/// tombstoning (PDPA s24).
///
/// `targetType` / `action` are plain String columns with CHECK constraints in
/// the migration (cf. Report, Event, JoinRequest convention — TEXT + CHECK,
/// not Postgres enums).
///
/// `contentSnapshot` captures the verbatim review text at action time when
/// action == 'resolve_hidden' (chain-of-custody evidence). NULL for 'touch'
/// and 'resolve_kept' (no content removed, original remains in live table).
///
/// `requestId` discriminates channel via `system:cli.moderation.<verb>:*`
/// pattern (mirrors account-deletion-sla.md §4 PDPC inspection posture).
///
/// TRI-193 extensions (Cat 4 cancel-event-for-safety):
///   - `action` CHECK now also permits 'cancel_event_for_safety'.
///   - `reportId` / `reporterUserId` are nullable: Cat 4 cancellations may
///     have no upstream report row (legal-blessed per TRI-195).
///   - `reasonCode` TEXT NULL — machine-readable safety code (e.g. 'safety').
///   - `justificationText` VARCHAR(500) NULL — operator free-text narrative.
///   - `originatingReportId` TEXT NULL — nullable link to a moderation_reports
///     row when the cancellation was triggered by an upstream report.
///
/// No application-layer UPDATE or prune path — append-only by contract.
/// Read access is out-of-band SQL only — no public-port read methods.
model ModerationActionAudit {
  id                   String    @id @default(cuid())
  operatorUserId       String
  action               String    // touch | resolve_hidden | resolve_kept | cancel_event_for_safety | escalate | record_external_input | resolve_with_override — CHECK enforced
  reportId             String?   // nullable: Cat 4 cancellations may have no upstream report (TRI-193)
  targetType           String    // review | user | event — CHECK enforced
  targetId             String
  reason               String?   @db.VarChar(500)  // required for resolve_*, null for touch
  contentSnapshot      String?   @db.Text          // verbatim target content at action time
  reporterUserId       String?   // nullable: no reporter when there is no upstream report (TRI-193)
  reasonCode           String?              // machine-readable safety code, e.g. 'safety' — CHECK enforced
  justificationText    String?   @db.VarChar(500)  // operator free-text narrative for cancel_event_for_safety
  originatingReportId  String?              // nullable link to a moderation_reports row (TRI-141 sweep join)
  escalationCategory   String?              // criminal-content | imminent-harm | ambiguous-policy | external-jurisdiction — CHECK enforced; populated when action='escalate' or 'resolve_with_override'
  externalRef          String?   @db.VarChar(500)  // populated when action='escalate'
  externalSource       String?              // counsel | partner | imda | other — CHECK enforced; populated when action='record_external_input'
  externalDisposition  String?   @db.VarChar(500)  // populated when action='record_external_input'
  externalReceivedAt   DateTime?            // operator-supplied ISO8601, distinct from actedAt; populated when action='record_external_input'
  actedAt              DateTime
  requestId            String?
  recordedAt           DateTime  @default(now())

  @@index([reportId])
  @@index([operatorUserId, actedAt])
  @@index([actedAt])
  @@index([requestId])
  @@index([originatingReportId])
  @@index([reportId, action])
  @@map("moderation_action_audit")
}

/// Aggregate root in the `selfies` bounded context.
/// Tracks a user's selfie submitted for identity verification.
///
/// Lifecycle: pending → approved | rejected → deleted.
/// Deletion cascades from any non-deleted state (AC #6 — pending, approved,
/// or rejected can all be deleted).
///
/// `status` is a plain String column (not Prisma enum) — consistent with
/// the codebase convention (cf. Event.status, JoinRequest.status). The
/// SelfieStatus VO in the domain layer enforces the closed enum.
///
/// `storageKey` is cleared to null on markDeleted — the actual S3 object
/// deletion is queued in `selfie_pending_storage_deletes` (AC #2).
///
/// `onDelete: Cascade` on the user FK: when a User is hard-deleted, their
/// selfies cascade. The `selfie_deletion_events` audit table uses a plain
/// String userId (not a relation) so audit evidence survives user deletion.
model Selfie {
  id         String    @id @default(cuid())
  userId     String
  status     String    // pending | approved | rejected | deleted
  storageKey String?   // S3 object key; cleared to null on deletion
  approvedAt DateTime?
  rejectedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, approvedAt])
  @@index([status, rejectedAt])
  @@map("selfies")
}

/// Queue of pending S3 object deletions for selfies.
///
/// Enqueued atomically alongside the selfie's `markDeleted` mutation so that
/// storage deletion survives application restarts and crashes. The storage
/// deletion worker pops rows, attempts deletion, and increments `attempts`
/// on failure. After `attempts` exceeds the configured max, the row stays
/// for manual review.
///
/// No FK to `selfies` — the selfie row may be deleted separately from the
/// storage object (intentional decoupling). `storageKey` is stored directly
/// so the worker can attempt deletion even after the selfie row is gone.
model SelfiePendingStorageDelete {
  id            String    @id @default(cuid())
  selfieId      String
  storageKey    String
  attempts      Int       @default(0)
  enqueuedAt    DateTime  @default(now())
  lastAttemptAt DateTime?
  lastError     String?

  @@index([attempts, enqueuedAt])
  @@map("selfie_pending_storage_deletes")
}

/// Per-tick observability record for scheduled sweep jobs.
///
/// One row is written per sweep execution (success or failure). Answers
/// "did the sweep run on date X?" for App Store / regulator audit requests.
///
/// `kind` is 'selfie-retention-sweep' at launch; future jobs (account-deletion
/// sweep, orphan-media reaper) can reuse this table by using a distinct kind.
model SweepRun {
  id              String    @id @default(cuid())
  kind            String    // 'selfie-retention-sweep' for this brief; future jobs can reuse the table
  startedAt       DateTime
  finishedAt      DateTime?
  evaluated       Int       @default(0)
  deleted         Int       @default(0)
  failed          Int       @default(0)
  reaperRetried   Int       @default(0)
  reaperSucceeded Int       @default(0)
  error           String?
  /// NULL for sweep kinds that don't sever cross-references (selfie-retention-sweep);
  /// an integer count for sweep kinds that do (report-retention-sweep).
  auditRowsSevered Int?

  @@index([kind, startedAt])
  @@map("sweep_runs")
}

/// Aggregate root in the `check-ins` bounded context.
/// Tracks a single attendee's post-event check-in for an event.
///
/// Lifecycle: pending → ok (acknowledged) | flagged.
/// Created automatically after an event ends for every approved attendee.
///
/// `status` is a plain String column (not Prisma enum) — consistent with
/// the codebase convention. A CHECK constraint in the migration enforces
/// the closed enum: status IN ('pending', 'ok', 'flagged').
///
/// The two `@relation` directives on User are named so Prisma can
/// distinguish attendee-side (postEventCheckIns) from host-side (HostedCheckIns).
model PostEventCheckIn {
  id                      String    @id @default(cuid())
  userId                  String
  eventId                 String
  hostUserId              String
  status                  String    // pending | ok | flagged — CHECK enforced by migration
  createdAt               DateTime  @default(now())
  acknowledgedAt          DateTime?
  flaggedAt               DateTime?
  reportBody              String?
  resolvedAt              DateTime?
  disclaimerAcknowledged  Boolean   @default(false) @map("disclaimer_acknowledged")

  // userId FK deliberately absent: TRI-134 pseudonymisation rewrites userId to a cuid2
  // with no User row; removing the FK lets check-ins remain queryable post-tombstone.
  // See migration drop_post_event_check_ins_user_fk.
  // hostUserId FK deliberately absent: same rationale — host may be tombstoned post-TRI-134.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([status, createdAt])
  @@index([hostUserId, status])
  @@map("post_event_check_ins")
}

/// Append-only audit log for post-event check-in lifecycle events.
///
/// Mirrors the `selfie_deletion_events` audit table shape (TRI-79 precedent).
/// No FK constraints on checkInId / userId / eventId — rows must outlive the
/// originating check-in record (PDPA s25 evidence-integrity requirement).
///
/// `reason` is a plain String column; a CHECK constraint in the migration
/// enforces the closed enum:
///   reason IN ('created', 'acknowledged', 'flagged', 'pseudonymised', 'deleted_by_retention')
///
/// `userId` is pseudonymised (set to opaque id) on account deletion, matching
/// the `selfie_deletion_events` cascade handling convention.
///
/// Pruned at 24 calendar months from `occurredAt` by the retention sweep job.
/// Read access is out-of-band SQL only — no public-port read methods.
model PostEventCheckInEvent {
  id         String   @id @default(cuid())
  checkInId  String   // FK omitted intentionally — survives cascade deletion of the check-in row
  userId     String   // pseudonymised in cascade (set to opaque id)
  eventId    String
  reason     String   // 'created' | 'acknowledged' | 'flagged' | 'pseudonymised' | 'deleted_by_retention' — CHECK enforced
  occurredAt DateTime
  requestId  String?
  recordedAt DateTime @default(now())

  @@index([occurredAt])
  @@index([userId, reason])
  @@map("post_event_check_in_events")
}

/// Aggregate root in the `support` bounded context.
/// Tracks a user-submitted in-app support contact form submission.
///
/// `userId` is a nullable String (NOT a relation/FK) — pseudonymise-by-repo
/// pattern (TRI-29 / TRI-134 precedent): the ticket survives account tombstone
/// without requiring a cascade delete on the support side.
///
/// `reportId` is free-text (NOT an FK to moderation_reports) — legal-compliance
/// guardrail: support persistence MUST NOT join to `moderation_reports`.
///
/// `category` / `status` are plain String columns with DB CHECK constraints
/// (per codebase convention: TEXT + CHECK, not Postgres enums).
///
/// `userEmailSnapshot` captures the user's email at submission time so the
/// support team can reply even if the user later tombstones their account.
model SupportTicket {
  id                String    @id @default(cuid())
  userId            String?   // NULL-able; plain String, NOT a relation — see model comment
  userEmailSnapshot String?   // NULL-able for pseudonymisation; captured at submission
  category          String    @db.VarChar(64) // report_followup_7d | account_signin | event_or_host | app_broken | feedback | other — CHECK enforced
  message           String    @db.Text
  reportId          String?   // free-text; NOT an FK to moderation_reports — see model comment
  status            String    @default("open") // open | resolved | discarded — CHECK enforced
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([category, createdAt])
  @@map("support_tickets")
}
