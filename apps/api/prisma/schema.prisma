// Prisma 7+: the datasource block no longer accepts `url`. Connection URLs
// for `prisma migrate` / `prisma studio` live in `prisma.config.ts`; the
// runtime PrismaClient connects via a driver adapter (see core/db/prisma.ts).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Aggregate root in the `users` bounded context.
/// Owns identity-as-known-to-the-business: who someone is to others on the platform.
///
/// Profile fields added in TRI-7 (all optional):
///   - bio          free-text self-description, max 300 chars
///   - avatarUrl    nullable URL; no upload pipeline (CEO constraint, TRI-7)
///   - languages    array of BCP-47-aligned codes from the platform picklist
///   - interests    array of activity codes from the platform picklist
///   - currentCity  free-text city name, max 80 chars (no geo-restriction)
///   - travelerType TEXT column, CHECK constraint enforces 'local'|'traveling'|'expat'
///                  per TRI-41 convention (string column + DB CHECK, not Prisma enum)
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  displayName     String
  emailVerifiedAt DateTime?
  bio             String?
  avatarUrl       String?
  languages       String[]
  interests       String[]
  currentCity     String?
  travelerType    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  credential               Credential?
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  hostedEvents             Event[]
  joinRequests             JoinRequest[]

  @@map("users")
}

/// Aggregate root in the `auth` bounded context.
/// Owns the secret material used to authenticate a user. Lives separately from User
/// so credential rotation, password changes, and future auth methods (OAuth, passkeys)
/// don't touch the User aggregate.
model Credential {
  userId         String   @id
  passwordHash   String
  passwordSetAt  DateTime @default(now())
  lastSignedInAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// Long-lived authentication credential. Each row is a single "session" — one device
/// or one logical client. Lives in the `auth` bounded context. The token itself is
/// hashed (SHA-256 over a 32-byte random secret); plaintext is shown to the client
/// once at issue time and never persisted.
///
/// Rotation: when /auth/refresh is called, the current token is marked revoked
/// (revokedReason='rotated') and a new RefreshToken is issued, with `rotatedToId`
/// pointing to the new row — preserving the chain for reuse-detection forensics.
///
/// Reuse-detection: if a token whose revokedAt is set (already-rotated) is presented
/// again, treat it as theft and revoke ALL of the user's tokens.
model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String? // 'rotated' | 'signed_out' | 'reuse_detected' | 'sign_out_all' | 'password_reset'
  lastUsedAt    DateTime?
  rotatedToId   String? // chain pointer to the next token after rotation
  deviceLabel   String? // optional, derived from User-Agent

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// One-time email verification code. Lives in the `auth` bounded context.
/// The 6-digit code shown to the user is hashed (SHA-256) at rest. Only one
/// open token per user at a time — issuing a new one revokes any prior open
/// row (single open invariant). `attempts` counts wrong-code submissions; use
/// cases invalidate the row once attempts hits the cap to defeat brute-force.
model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  codeHash    String
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  invalidated Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// One-time password-reset code. Lives in the `auth` bounded context.
/// Same shape as EmailVerificationToken (both compose the OneTimeCodeLifecycle
/// VO at the domain layer), but a separate table — different lifecycle, different
/// retention, different audit trail. The 6-digit code shown to the user is hashed
/// (SHA-256) at rest. Only one open token per user at a time — issuing a new one
/// invalidates any prior open row (single open invariant). `attempts` counts
/// wrong-code submissions; the row self-invalidates once attempts hits the cap to
/// defeat brute-force.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  codeHash    String
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  invalidated Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Aggregate root in the `events` bounded context. The core "thing happening"
/// a host creates and others request to join. Lifecycle: draft → published →
/// (cancelled | completed); transitions are enforced by the domain layer.
///
/// Venue is denormalized onto the row (no separate venues table) — Singapore-
/// only MVP doesn't justify a venue registry yet. `venueLatitude` /
/// `venueLongitude` are NUMERIC(9,6) (≈ 11 cm precision globally). PostGIS is
/// a deliberate non-goal for MVP; distance queries (TRI-19) can use
/// `earth_distance` or app-side calculation, with a PostGIS migration in a
/// later issue once geospatial query volume justifies it.
///
/// `category` / `costSplit` / `approvalMode` / `status` are plain String
/// columns rather than Prisma enums — matches the codebase convention
/// (cf. `revokedReason` on RefreshToken) and avoids Prisma enum migration
/// friction when values evolve. Type guards in the mapper narrow strings
/// back to unions when rehydrating.
///
/// `onDelete: Cascade` on the host FK reflects the PDPA policy: user records
/// are NOT casually deleted (hard delete only on a verified deletion request),
/// at which point cascading their hosted events is the correct behaviour.
model Event {
  id                 String   @id @default(cuid())
  hostUserId         String
  title              String
  description        String?
  venueAddress       String
  venueCity          String
  venueLatitude      Decimal  @db.Decimal(9, 6)
  venueLongitude     Decimal  @db.Decimal(9, 6)
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int
  category           String // drinks | food | hike | museum | sports | nightlife | other
  venueCategory      String @default("other") // hawker_centre | park | museum | ... | other (CHECK enforced by migration)
  costSplit          String // own | host_paid | split
  approvalMode       String // auto | manual
  status             String // draft | published | cancelled | completed
  cancellationReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  host         User          @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  joinRequests JoinRequest[]

  @@index([hostUserId])
  @@index([status, startsAt])
  @@index([category, startsAt])
  @@index([venueCity, startsAt])
  @@map("events")
}

/// Aggregate root in the `join-requests` bounded context. Tracks a single
/// user's request to join an event. Lifecycle: pending → (approved|rejected|cancelled).
/// Strict idempotency: same-state transitions throw 409 with a structured subcode
/// in details, NOT silent no-ops — protects the audit chain (see TRI-20).
///
/// Capacity correctness: approval reads parent Event row FOR UPDATE inside the
/// transaction, counts approved siblings, compares against (capacity - 1) since
/// capacity includes the host.
///
/// One ACTIVE request per (event, requester) is enforced by a partial unique
/// index added in the migration directly (Prisma DSL doesn't model partial
/// unique constraints as of v7). After reject/cancel the row stays for audit
/// but no longer matches the partial predicate — user can request again.
model JoinRequest {
  id              String    @id @default(cuid())
  eventId         String
  requesterUserId String
  status          String // pending | approved | rejected | cancelled
  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  decisionReason  String?

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([requesterUserId, status])
  @@map("join_requests")
}

/// Transactional outbox: domain events written in the same Postgres transaction
/// as the data change that produced them. Append-only — the dispatcher tracks
/// progress per consumer in `consumer_offsets`, not on the event row.
///
/// `seq` is the monotonic offset consumers commit against. `requestId` /
/// `actorUserId` carry HTTP correlation forward into the dispatch tick (the
/// dispatcher re-establishes the AsyncLocalStorage frame from these fields).
model OutboxEvent {
  id            String   @id @default(cuid())
  seq           BigInt   @unique @default(autoincrement())
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime @default(now())
  requestId     String?
  actorUserId   String?

  @@index([seq])
  @@index([type, seq])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Per-consumer offset cursor. Each registered Consumer has one row identified
/// by `consumerName` (e.g. `auth.issueEmailVerificationOnUserRegistered`).
///
/// Maps to Kafka's `__consumer_offsets` topic: `committedSeq` is what the
/// consumer has finished processing; `inFlightSeq` is the row currently being
/// retried (head-of-line block — dispatcher will not advance past a failure
/// until that specific event succeeds or hits `maxAttempts` and is parked).
///
/// `blockedAt` is set when attempts exceeds the consumer's max — manual
/// intervention required (clear `blockedAt` + reset `attempts` to resume).
model ConsumerOffset {
  consumerName String    @id
  topic        String
  committedSeq BigInt    @default(0)
  inFlightSeq  BigInt?
  attempts     Int       @default(0)
  lastError    String?
  lastErrorAt  DateTime?
  blockedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([topic])
  @@index([blockedAt])
  @@map("consumer_offsets")
}

/// Audit row per inbound HTTP request. Bounded context: `audit` feature.
/// Body content is intentionally NOT stored (PDPA-friendly); only headers,
/// status, duration, actor identity. Domain payloads from the request live in
/// `outbox_events` already.
model HttpAuditLog {
  id          String   @id @default(cuid())
  requestId   String   @unique
  method      String
  path        String
  status      Int
  durationMs  Int
  actorUserId String?
  ip          String?
  userAgent   String?
  errorCode   String?
  receivedAt  DateTime @default(now())

  @@index([actorUserId, receivedAt])
  @@index([receivedAt])
  @@map("http_audit_logs")
}

/// Audit row per event lifecycle phase. `phase` distinguishes:
///   - `published`  (consumerName=null) — event was written to the outbox
///   - `dispatched` — consumer handled successfully
///   - `failed`     — consumer threw; will retry next tick
///   - `blocked`    — consumer hit maxAttempts; parked for manual review
model EventAuditLog {
  id           String   @id @default(cuid())
  requestId    String?
  eventSeq     BigInt
  eventType    String
  consumerName String?
  phase        String
  attempt      Int?
  errorMessage String?
  recordedAt   DateTime @default(now())

  @@index([requestId])
  @@index([eventSeq, consumerName])
  @@index([consumerName, phase, recordedAt])
  @@map("event_audit_logs")
}
