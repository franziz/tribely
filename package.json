{
  "name": "tribely",
  "version": "0.0.1",
  "private": true,
  "description": "Tribely monorepo — Flutter mobile app + Hono API",
  "workspaces": [
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "api:dev": "npm run dev --workspace=@tribely/api",
    "api:dev:fresh": "node scripts/kill-port.mjs 3000 && npm run api:dev",
    "api:kill-port": "node scripts/kill-port.mjs 3000",
    "api:build": "npm run build --workspace=@tribely/api",
    "api:start": "npm run start --workspace=@tribely/api",
    "api:db:generate": "npm run db:generate --workspace=@tribely/api",
    "api:db:migrate": "npm run db:migrate --workspace=@tribely/api",
    "api:db:migrate:create": "npm run db:migrate:create --workspace=@tribely/api",
    "api:db:migrate:deploy": "npm run db:migrate:deploy --workspace=@tribely/api",
    "api:db:studio": "npm run db:studio --workspace=@tribely/api",
    "mobile:devices": "cd apps/mobile && flutter devices",
    "mobile:run": "cd apps/mobile && flutter run --dart-define-from-file=.env.json",
    "mobile:build:apk": "cd apps/mobile && flutter build apk --dart-define-from-file=.env.json",
    "mobile:build:ios": "cd apps/mobile && flutter build ios --dart-define-from-file=.env.json",
    "mobile:codegen": "melos run build_runner",
    "mobile:analyze": "melos run analyze",
    "mobile:test": "melos run test",
    "mobile:format": "melos run format",
    "mobile:format:check": "melos run format:check",
    "migrate": "npm run api:db:migrate && npm run mobile:codegen",
    "codegen": "npm run api:db:generate && npm run mobile:codegen",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"package.json\" \"apps/*/package.json\" \"tsconfig*.json\"",
    "format:check": "prettier --check \"package.json\" \"apps/*/package.json\" \"tsconfig*.json\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
